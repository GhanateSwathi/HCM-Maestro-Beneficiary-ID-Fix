# Template for .env - copy to .env and fill in the values. Never commit .env.
#
# scripts/run.ps1 and scripts/run.sh forward every KEY=VALUE line here to
# Maestro as -e KEY=VALUE, so flows read them as ${KEY}. Add each new key with
# a comment saying which flow or subflow uses it.

# App under test. The Kaduna fix build installs as org.egov.azm.gombe (label
# ADAMAWA-AZM), not org.egov.kaduna - confirmed OK for Kaduna on 2026-10-30.
HCM_APP_ID=org.egov.azm.gombe

# CDD user that registers households and holds the beneficiary ID pool.
HCM_CDD_USER_ID=
HCM_CDD_PASSWORD=

# adb serial of the test device (adb devices): emulator-5554 for the
# HCM_Beneficiary_ID emulator (scripts/start-emulator.ps1), or a phone's serial.
DEVICE_ID=
# The second device for the two-device cases X9 and D5 (case parts named
# "...@2.yaml" run on it): emulator-5556 for HCM_Beneficiary_ID_2.
DEVICE_ID_2=

# The fix build's APK, installed by scripts/start-emulator.ps1 when missing.
HCM_APK=

# Boundary picked after sign-in (subflows/common/home.yaml): the CDD's health
# facility and the one community every case registers in. dis-qa-oct29 has
# Fangwani Health Clinic and 13 communities; Rigan Ori had no records on
# 2026-10-30.
HEALTH_FACILITY=Fangwani Health Clinic
REGISTRATION_VILLAGE=Rigan Ori

# Test people (subflows/registration/). Names come from each case
# (QAID-<case>-<letter>); these fill the rest of the form. The plan asks for a
# member count of 5 so members can be added later, and a head aged 18+.
HOUSEHOLD_MEMBERS=5
HEAD_AGE_YEARS=30
HEAD_GENDER=Female
LAST_NAME=Test

# Members added with Add Members (subflows/registration/add-member.yaml): the
# plan asks for a child aged 3-59 months. Height is required once the age is
# in.
MEMBER_AGE_YEARS=2
MEMBER_GENDER=Female
MEMBER_HEIGHT_CM=85
