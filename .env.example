# Template for .env - copy to .env and fill in the values. Never commit .env.
#
# scripts/run.ps1 and scripts/run.sh forward every KEY=VALUE line here to
# Maestro as -e KEY=VALUE, so flows read them as ${KEY}. Add each new key with
# a comment saying which flow or subflow uses it.

# App under test - two builds, each with its own package, server and CDD:
#   Kaduna 2.2.120  org.egov.azm.gombe (label ADAMAWA-AZM, confirmed OK for
#                   Kaduna on 2026-10-30), kaduna-central-hcm.digit.org
#   Kebbi 2.2.122   org.egov.azm.kebbi (label KEBBI-AZM),
#                   kebbi-azm-central-hcm.digit.org - the re-run of X9, X9b
#                   and D5 (cases X9-122, X9b-122, D5-122), 2026-11-03
# Set HCM_APP_ID, HCM_APK, the CDD and the boundary to one build's values.
HCM_APP_ID=org.egov.azm.kebbi

# CDD user that registers households and holds the beneficiary ID pool.
HCM_CDD_USER_ID=
HCM_CDD_PASSWORD=

# adb serial of the test device (adb devices): emulator-5554 for the
# HCM_Beneficiary_ID emulator (scripts/start-emulator.ps1), or a phone's serial.
DEVICE_ID=
# The second device for the two-device cases X9 and D5 (case parts named
# "...@2.yaml" run on it): emulator-5556 for HCM_Beneficiary_ID_2.
DEVICE_ID_2=

# Both builds' APKs, kept to switch between them; HCM_APK is the one
# scripts/start-emulator.ps1 installs when HCM_APP_ID is missing. Start the
# emulators with -UatHost set to that build's server.
HCM_APK_KADUNA=
HCM_APK_KEBBI=
HCM_APK=

# Boundary picked after sign-in (subflows/common/home.yaml): the CDD's health
# facility and the one community every case registers in. Kaduna:
# dis-qa-oct29 has Fangwani Health Clinic and 13 communities (Rigan Ori had no
# records on 2026-10-30). Kebbi: ke-azm-cdd-01 has ke Garadi Health Post and
# 12 communities; Tungar Yari is used.
HEALTH_FACILITY=ke Garadi Health Post
REGISTRATION_VILLAGE=Tungar Yari

# Test people (subflows/registration/). Names come from each case
# (QAID-<case>-<letter>); these fill the rest of the form. The plan asks for a
# member count of 5 so members can be added later, and a head aged 18+.
HOUSEHOLD_MEMBERS=5
HEAD_AGE_YEARS=30
HEAD_GENDER=Female
LAST_NAME=Test

# Members added with Add Members (subflows/registration/add-member.yaml): the
# plan asks for a child aged 3-59 months. Height is required once the age is
# in.
MEMBER_AGE_YEARS=2
MEMBER_GENDER=Female
MEMBER_HEIGHT_CM=85
